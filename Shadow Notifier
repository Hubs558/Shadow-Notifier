local networking = ReplicatedStorage:WaitForChild("Packages", 20):WaitForChild("Networking", 20)
local AskFieldEggSnapshot = networking:WaitForChild("RF/EggWorld/AskFieldEggSnapshot", 20)

local AssetsDir, Mutations = nil, nil
pcall(function() AssetsDir = require(ReplicatedStorage.Data.Assets).Directory end)
pcall(function() Mutations = require(ReplicatedStorage.Shared.Modules.Mutations) end)

local function getEggData(record)
    if not AssetsDir then return nil end
    local asset = AssetsDir[record.AssetCategory]
    if not asset then return nil end
    local baseRate = tonumber(asset.EarningRate) or 0
    local scale = tonumber(record.AssetScale) or 1
    local mutMult = 1
    if record.Mutations and #record.Mutations > 0 and Mutations and type(Mutations.EarningsFor) == "function" then
        local ok, r = pcall(Mutations.EarningsFor, record.Mutations)
        if ok then mutMult = tonumber(r) or 1 end
    end
    local gen = baseRate * (scale <= 5 and scale ^ 1.85 or (scale / 5) ^ 1.2 * 19.6378) * mutMult
    local rarName = asset.Rarity and (asset.Rarity.DisplayName or asset.Rarity.Name) or ""
    return { Uid = record.Uid, Nome = asset.DisplayName or record.AssetCategory, Geracao = math.floor(gen + 0.5), RarityName = rarName }
end

while true do
    local bestAchado = nil
    local tempoInicioBusca = os.clock()

    while true do
        local ok, snap = pcall(function() return AskFieldEggSnapshot:InvokeServer() end)

        if ok and snap and snap.Records then
            for _, r in ipairs(snap.Records) do
                if r and r.Uid and (r.State == "Slot" or r.State == "Dropped") then
                    local d = getEggData(r)
                    if d and RARIDADES_PERMITIDAS[norm(d.RarityName)] and petPermitido(d.Nome) then
                        if not bestAchado then
                            bestAchado = d
                            tempoInicioBusca = os.clock()
                        elseif d.Geracao > bestAchado.Geracao then
                            bestAchado = d
                        end
                    end
                end
            end
        end

        if bestAchado and (os.clock() - tempoInicioBusca) >= TEMPO_ESPERA_MELHOR then
            break
        end

        task.wait(0.1)
    end

    if bestAchado then
        ovosAchados += 1
        enviarDiscord(bestAchado)
        enviarWebSocket(bestAchado)
        fazerServerHop()
        break
    end
end
