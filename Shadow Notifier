local function norm(s) return tostring(s or ""):lower():gsub("[%s%-_']", "") end
local PET_NORM = {}
for k, v in pairs(PET_IMAGES) do PET_NORM[norm(k)] = v end
local function getPetImage(name) return PET_NORM[norm(name)] end

-- Verifica se a whitelist tem algum item ativado
local function temWhitelistAtiva()
    for _, ativo in pairs(WHITELIST) do
        if ativo == true then return true end
    end
    return false
end

-- Verifica se o pet passou na whitelist e na blacklist
local function petPermitido(nome)
    local n = norm(nome)
    
    -- Blacklist: se tá true, recusa
    for pet, ativo in pairs(BLACKLIST) do
        if ativo == true and norm(pet) == n then
            return false
        end
    end
    
    -- Whitelist: se tem algo true, SÓ aceita os que tão true
    if temWhitelistAtiva() then
        for pet, ativo in pairs(WHITELIST) do
            if ativo == true and norm(pet) == n then
                return true
            end
        end
        return false
    end
    
    -- Se não tem whitelist ativa, aceita qualquer coisa (que não esteja na blacklist)
    return true
end

