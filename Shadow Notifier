local function fazerServerHop()
    agendarReinjeccao()

    local TeleportService = game:GetService("TeleportService")
    local servidores = {}

    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Asc&limit=100"
        local resp = game:HttpGet(url, true, { ["User-Agent"] = "Roblox/WinInet" })
        local data = Http:JSONDecode(resp)
        if data and data.data then
            for _, srv in ipairs(data.data) do
                local jobId = tostring(srv.id)
                if tonumber(srv.playing) < tonumber(srv.maxPlayers) 
                   and jobId ~= game.JobId 
                   and not servidoresVisitados[jobId] then
                    table.insert(servidores, srv)
                end
            end
        end
    end)

    if #servidores == 0 then
        servidoresVisitados = {}
        pcall(function() TeleportService:Teleport(PLACE_ID, LocalPlayer) end)
        return
    end

    for i = #servidores, 2, -1 do
        local j = math.random(i)
        servidores[i], servidores[j] = servidores[j], servidores[i]
    end

    for i, srv in ipairs(servidores) do
        local jobId = tostring(srv.id)
        local falhou = false
        local conn = TeleportService.TeleportInitFailed:Connect(function() falhou = true end)
        
        pcall(function() TeleportService:TeleportToPlaceInstance(PLACE_ID, jobId, LocalPlayer) end)
        
        task.wait(3)
        conn:Disconnect()
        
        if not falhou then
            servidoresVisitados[jobId] = os.time()
            servidoresPassados += 1
            salvarCache()
            return
        end
    end
    
    servidoresVisitados = {}
    pcall(function() TeleportService:Teleport(PLACE_ID, LocalPlayer) end)
end

