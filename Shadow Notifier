local function formatarTempo(segundos)
    local horas = math.floor(segundos / 3600)
    local minutos = math.floor((segundos % 3600) / 60)
    local secs = segundos % 60
    if horas > 0 then return string.format("%dh %dm", horas, minutos)
    elseif minutos > 0 then return string.format("%dm %ds", minutos, secs)
    end
    return string.format("%ds", secs)
end

